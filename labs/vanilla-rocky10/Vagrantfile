# frozen_string_literal: true
# =============================================================================
# Lab vanilla Rocky Linux 10 — alineado a ex200-personal-practice.arceprog.dev / simulacro
# client 172.16.1.12 · server 172.16.1.13 · hostnames *.rhcsa.lab
#
# Dónde correrlo: PC de casa (Rocky) con VirtualBox + Vagrant.
# En el Windows del trabajo Vagrant suele ir muy lento (Hyper-V / sin VT-x).
# Ahí usá las VMs de VirtualBox o cloná una limpia; no dependas de este archivo.
#
# Uso (desde esta carpeta):
#   vagrant up
#   vagrant ssh client
#   vagrant ssh server
#   vagrant halt
#   vagrant destroy -f          # vuelve a cero (vanilla otra vez)
# =============================================================================

Vagrant.configure("2") do |config|
  config.vm.boot_timeout = 1200
  config.vm.box = "rockylinux/10"
  config.vm.box_url =
    "https://dl.rockylinux.org/pub/rocky/10/images/x86_64/Rocky-10-Vagrant-Vbox.latest.x86_64.vagrant.virtualbox.box"
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.ssh.insert_key = true

  {
    "server" => {
      ip:   "172.16.1.13",
      mem:  2048,
      cpus: 2,
      hostname: "server.rhcsa.lab",
      # httpd y utils mínimos: el simulacro asume que el server puede servir HTTP.
      # El resto (usuarios, LVM, etc.) lo hacés vos en el lab.
      pkgs: "httpd firewalld policycoreutils-python-utils vim-enhanced man-pages man-db",
      extra: <<-SHELL
        systemctl enable --now httpd firewalld
        firewall-cmd --permanent --add-service=http
        firewall-cmd --permanent --add-service=ssh
        firewall-cmd --reload
        # Root con contraseña desconocida: hay que recuperarla por consola (lab-02).
        # SSH como vagrant + sudo sigue andando para el resto de labs.
        ROOT_PW=$(openssl rand -base64 24)
        echo "root:${ROOT_PW}" | chpasswd
        passwd -l vagrant 2>/dev/null || true
        # vagrant sigue entrando por clave SSH; no por password.
        echo "==> root password set to a random value and not stored. Practice reset on VirtualBox console."
      SHELL
    },
    "client" => {
      ip:   "172.16.1.12",
      mem:  1024,
      cpus: 1,
      hostname: "client.rhcsa.lab",
      pkgs: "curl lynx firewalld vim-enhanced man-pages man-db",
      extra: <<-SHELL
        systemctl enable --now firewalld
        firewall-cmd --permanent --add-service=ssh
        firewall-cmd --reload
      SHELL
    }
  }.each do |name, opts|
    config.vm.define name do |vm|
      vm.vm.hostname = opts[:hostname]
      vm.vm.network "private_network",
        ip: opts[:ip],
        netmask: "255.255.255.0"

      vm.vm.provider "virtualbox" do |vb|
        vb.name   = "arceprog-rhcsa-#{name}"
        vb.memory = opts[:mem]
        vb.cpus   = opts[:cpus]
        vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]

        if name == "server"
          disk_path = File.join(Dir.pwd, "disk1.vdi")
          unless File.exist?(disk_path)
            vb.customize ["createhd", "--filename", disk_path, "--size", 2048]
          end
          vb.customize [
            "storageattach", :id,
            "--storagectl", "SATA Controller",
            "--port", 1, "--device", 0,
            "--type", "hdd", "--medium", disk_path
          ]
        end
      end

      vm.vm.provision "shell", privileged: true, inline: <<-SHELL
        set -euo pipefail
        dnf -qy install openssh-server
        systemctl enable --now sshd
        dnf -qy install #{opts[:pkgs]}
        #{opts[:extra]}
      SHELL
    end
  end
end
