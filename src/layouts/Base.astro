---
import "../styles/global.css";
import {
  cvUrl,
  getLocaleConfig,
  getUI,
  otherLocale,
  routePath,
  SITE,
  swapLocalePath,
  type Locale,
  type RouteId,
} from "../lib/i18n";

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  /** Logical page id; drives localized URLs and language switch. */
  route?: RouteId;
}

const { title, description, locale = "es", route = "home" } = Astro.props;
/** The header stays on screen while scrolling. Set to false to put it back in the page flow. */
const HEADER_FOLLOWS = true;
const ui = getUI(locale);
const config = getLocaleConfig(locale);
const other = otherLocale(locale);
const path = routePath(locale, route);
const alternateEs = new URL(routePath("es", route), SITE).href;
const alternateEn = new URL(routePath("en", route), SITE).href;
const canonical = new URL(path, SITE).href;
const fullTitle = title.includes("arceprog") ? title : `${title} | arceprog`;
const home = routePath(locale, "home");
const stats = routePath(locale, "stats");
const glossary = routePath(locale, "glossary");
const otherHref = swapLocalePath(path, other);
---

<!doctype html>
<html lang={config.htmlLang} data-locale={locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function () {
        var theme = "dark";
        try {
          var saved = localStorage.getItem("arceprog:rhcsa-theme");
          if (saved === "light" || saved === "dark") theme = saved;
        } catch (e) {}
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-AR" href={alternateEs} />
    <link rel="alternate" hreflang="en-US" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateEs} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={config.ogLocale} />
    <meta property="og:locale:alternate" content={getLocaleConfig(other).ogLocale} />
    <meta http-equiv="content-language" content={locale} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-paper text-ink antialiased">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-card focus:px-3 focus:py-2">
      {ui.skip}
    </a>
    <header class:list={["site-bar", { "site-header-follow": HEADER_FOLLOWS }]}>
      <div class="waybar mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-5 py-4">
        <a href={home} class="group flex items-center gap-3 no-underline">
          <svg
            class="h-8 w-8 shrink-0"
            viewBox="0 0 40 40"
            width="32"
            height="32"
            aria-hidden="true"
            focusable="false"
          >
            <circle cx="20" cy="20" r="19" fill="var(--logo-ring)" stroke="var(--logo-stroke)" stroke-width="1.25"></circle>
            <ellipse cx="20" cy="24" rx="11" ry="11.5" fill="var(--logo-body)"></ellipse>
            <ellipse cx="20" cy="25.5" rx="6.8" ry="8" fill="var(--logo-belly)"></ellipse>
            <circle cx="20" cy="12.5" r="7" fill="var(--logo-body)"></circle>
            <circle cx="16.8" cy="12" r="1.55" fill="var(--logo-belly)"></circle>
            <circle cx="23.2" cy="12" r="1.55" fill="var(--logo-belly)"></circle>
            <circle cx="17" cy="12.2" r="0.6" fill="var(--logo-pupil)"></circle>
            <circle cx="23.4" cy="12.2" r="0.6" fill="var(--logo-pupil)"></circle>
            <path d="M17.4 14.8 L20 17.4 L22.6 14.8 Z" fill="#e8a317"></path>
            <ellipse cx="11.5" cy="27" rx="3" ry="1.7" fill="#e8a317" transform="rotate(-28 11.5 27)"></ellipse>
            <ellipse cx="28.5" cy="27" rx="3" ry="1.7" fill="#e8a317" transform="rotate(28 28.5 27)"></ellipse>
          </svg>
          <span class="flex items-baseline gap-3">
            <span class="text-sm font-semibold tracking-[0.18em] text-ink uppercase">arceprog</span>
            <span class="brand-note text-sm text-muted group-hover:text-ink">{ui.brand}</span>
          </span>
        </a>
        <nav class="flex items-center gap-4 text-sm font-medium" aria-label={ui.nav}>
          <a class="text-muted no-underline hover:text-ink" href={`${stats}?mode=fixed`}>{ui.statsNav}</a>
          <a class="text-muted no-underline hover:text-ink" href={glossary}>{ui.glossaryNav}</a>
          <a class="text-muted no-underline hover:text-ink" href={cvUrl(locale)}>{ui.cv}</a>
          <button
            id="theme-toggle"
            class="theme-toggle cursor-pointer border border-ink bg-transparent text-ink"
            type="button"
            data-light-label={ui.themeToLight}
            data-dark-label={ui.themeToDark}
            aria-label={ui.themeToLight}
          >
            <svg class="theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2.5v2.2M12 19.3v2.2M4.4 4.4l1.6 1.6M18 18l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.4 19.6l1.6-1.6M18 6l1.6-1.6"></path>
            </svg>
            <svg class="theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M20 14.5A7.5 7.5 0 0 1 9.5 4 7.2 7.2 0 1 0 20 14.5z"></path>
            </svg>
          </button>
          <a
            class="rounded-full border border-ink px-2.5 py-1 text-xs font-semibold tracking-wide no-underline"
            href={otherHref}
            hreflang={getLocaleConfig(other).htmlLang}
            aria-label={`${other.toUpperCase()}, ${getLocaleConfig(other).label}`}
            onclick={`localStorage.setItem('locale-preference', '${other}')`}
            data-locale-swap
          >
            {other.toUpperCase()}
          </a>
        </nav>
      </div>
    </header>
    <p class="exam-status">
      {ui.bannerLead}
      <span id="exam-days" class="font-medium text-ink" data-locale={locale}></span>
      {ui.bannerTail}
    </p>
    <script is:inline>
      (function () {
        var el = document.getElementById("exam-days");
        if (!el) return;
        var locale = el.getAttribute("data-locale") || "es";
        var exam = new Date(2026, 10, 6);
        var now = new Date();
        var today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        var days = Math.round((exam.getTime() - today.getTime()) / 86400000);
        var text;
        if (locale === "en") {
          if (days > 1) text = days + " days left.";
          else if (days === 1) text = "1 day left.";
          else if (days === 0) text = "Today.";
          else text = "That date has passed.";
        } else if (days > 1) text = "Faltan " + days + " días.";
        else if (days === 1) text = "Falta 1 día.";
        else if (days === 0) text = "Es hoy.";
        else text = "Esa fecha ya pasó.";
        el.textContent = " " + text + " ";
      })();
    </script>
    <main id="contenido">
      <slot />
    </main>
    <footer class="border-t border-line/80 no-print">
      <div class="mx-auto max-w-5xl px-5 py-4 text-xs leading-relaxed text-muted">
        <p>{ui.footerLegal}</p>
      </div>
    </footer>
    <div class="footer-veil no-print" aria-hidden="true"></div>
    <button id="glossary-shortcut" class="glossary-shortcut no-print" type="button">
      <kbd>Ctrl</kbd>+<kbd>K</kbd> {ui.glossaryNav}
    </button>
    <script>
      import { mountGlossaryPopup, openGlossaryPopup } from "../scripts/glossary-popup";
      mountGlossaryPopup();
      document.getElementById("glossary-shortcut")?.addEventListener("click", () => openGlossaryPopup());
    </script>
    <script is:inline>
      (function () {
        const path = window.location.pathname;
        const isRoot = path === "/";
        const hasPreference = localStorage.getItem("locale-preference");
        const ua = navigator.userAgent || "";
        const isBot = /bot|crawler|spider|bing|google|slurp|duckduck/i.test(ua);
        if (isRoot && !hasPreference && !isBot) {
          const lang = navigator.language || "es";
          if (!lang.toLowerCase().startsWith("es")) {
            localStorage.setItem("locale-preference", "en");
            window.location.replace("/en/");
          } else {
            localStorage.setItem("locale-preference", "es");
          }
        }
        const swap = document.querySelector("[data-locale-swap]");
        if (swap && window.location.search) {
          const href = swap.getAttribute("href") || "/";
          swap.setAttribute("href", href + (href.includes("?") ? "&" : "?") + window.location.search.slice(1));
        }
        var themeBtn = document.getElementById("theme-toggle");
        if (themeBtn) {
          var themeKey = "arceprog:rhcsa-theme";
          var paintTheme = function () {
            var light = document.documentElement.getAttribute("data-theme") === "light";
            themeBtn.setAttribute("aria-label", light ? themeBtn.getAttribute("data-dark-label") : themeBtn.getAttribute("data-light-label"));
          };
          paintTheme();
          themeBtn.addEventListener("click", function () {
            var next = document.documentElement.getAttribute("data-theme") === "light" ? "dark" : "light";
            document.documentElement.setAttribute("data-theme", next);
            try { localStorage.setItem(themeKey, next); } catch (e) {}
            paintTheme();
          });
        }
      })();
    </script>
  </body>
</html>
