---
import Base from "../layouts/Base.astro";
import { getUI, type Locale } from "../lib/i18n";
import { YT_PLAYLIST, LAB_REPO, REDHAT_EXAM_VIDEO } from "../lib/labs";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUI(locale);
---

<Base title={ui.homeTitle} description={ui.homeDescription} locale={locale} path="/">
  <div class="mx-auto flex max-w-5xl flex-col gap-8 px-5 py-10">
    <section class="grid gap-8 lg:grid-cols-[1.3fr_0.7fr] lg:items-end">
      <div>
        <p class="max-w-xl text-lg">{ui.hello}</p>
        <p class="mt-4 text-sm font-semibold tracking-[0.18em] text-muted uppercase">{ui.kicker}</p>
        <h1 class="mt-2 max-w-xl text-4xl font-semibold tracking-tight sm:text-5xl">{ui.headline}</h1>
        <p class="mt-4 max-w-xl text-lg text-muted">
          {ui.leadBefore}<a class="text-ink underline decoration-line underline-offset-2" href={REDHAT_EXAM_VIDEO}>{ui.videoTitle}</a>{ui.leadAfter}
        </p>
        <div class="mt-6">
          <p class="text-sm font-semibold tracking-[0.14em] text-muted uppercase">{ui.startModesLabel}</p>
          <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <button id="start-pausable" class="btn btn-primary" type="button">{ui.startPausable}</button>
            <button id="start-fixed" class="btn btn-quiet" type="button">{ui.startFixed}</button>
            <button id="resume-exam" class="btn btn-quiet hidden" type="button">{ui.resume}</button>
          </div>
          <p class="mt-3 max-w-xl text-sm text-muted">{ui.modesNote}</p>
          <p class="mt-3">
            <a class="text-sm font-medium text-ink underline decoration-line underline-offset-2" href={locale === "en" ? "/en/estadisticas/" : "/estadisticas/"}>{ui.seeStats}</a>
          </p>
          <p id="start-note" class="mt-2 text-sm text-muted">{ui.timesNote}</p>
        </div>
      </div>
      <section class="rounded-3xl border border-line bg-card p-5" aria-labelledby="delta-title">
        <h2 id="delta-title" class="text-sm font-semibold tracking-[0.16em] text-muted uppercase">{ui.improvement}</h2>
        <p id="stat-delta" class="mt-3 text-2xl font-semibold tracking-tight">{ui.loading}</p>
      </section>
    </section>

    <section class="grid gap-3 sm:grid-cols-4" aria-label={ui.runs}>
      <article class="rounded-3xl border border-line bg-card px-4 py-4">
        <p class="text-sm text-muted">{ui.runs}</p>
        <p id="stat-runs" class="stat-value mt-1 text-3xl font-semibold">—</p>
      </article>
      <article class="rounded-3xl border border-line bg-card px-4 py-4">
        <p class="text-sm text-muted">{ui.best}</p>
        <p id="stat-best" class="stat-value mt-1 text-3xl font-semibold">—</p>
      </article>
      <article class="rounded-3xl border border-line bg-card px-4 py-4">
        <p class="text-sm text-muted">{ui.withHelp}</p>
        <p id="stat-help" class="stat-value mt-1 text-3xl font-semibold">—</p>
      </article>
      <article class="rounded-3xl border border-line bg-card px-4 py-4">
        <p class="text-sm text-muted">{ui.passed}</p>
        <p id="stat-skip" class="stat-value mt-1 text-3xl font-semibold">—</p>
      </article>
    </section>

    <section id="last-run" class="hidden rounded-3xl border border-line bg-card px-5 py-4">
      <p class="text-sm text-muted">{ui.lastClose} · <span data-when></span></p>
      <p data-detail class="stat-value mt-1 text-lg font-semibold"></p>
    </section>

    <section class="rounded-3xl border border-warn/40 bg-[#f8f1e4] p-5 sm:p-6">
      <h2 class="text-lg font-semibold">{ui.updatesTitle}</h2>
      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-muted">{ui.updatesIntro}</p>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed">
        {ui.updates.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="rounded-3xl border border-line bg-card p-5 sm:p-6">
      <h2 class="text-lg font-semibold">{ui.kitTitle}</h2>
      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-muted">{ui.kitBody}</p>
      <ul class="mt-3 list-disc space-y-1 pl-5 text-sm leading-relaxed">
        {ui.kitItems.map((item) => <li>{item}</li>)}
      </ul>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">{ui.kitCaveat}</p>
    </section>

    <section class="grid gap-4 lg:grid-cols-3">
      <article class="rounded-3xl border border-line bg-card p-5">
        <h2 class="text-lg font-semibold">{ui.howTitle}</h2>
        <ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted">
          {ui.how.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="rounded-3xl border border-line bg-card p-5">
        <h2 class="text-lg font-semibold">{ui.helpTitle}</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">{ui.helpBody}</p>
      </article>
      <article class="rounded-3xl border border-line bg-card p-5">
        <h2 class="text-lg font-semibold">{ui.vmsTitle}</h2>
        <dl class="mt-3 space-y-2 text-sm">
          <div class="flex justify-between gap-3"><dt class="text-muted">client</dt><dd class="stat-value">172.16.1.12</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-muted">server</dt><dd class="stat-value">172.16.1.13</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-muted">gateway / DNS</dt><dd class="stat-value">172.16.1.1</dd></div>
        </dl>
        <p class="mono mt-3 text-sm text-ink">vagrant ssh client</p>
        <p class="mono text-sm text-ink">vagrant ssh server</p>
      </article>
    </section>

    <footer class="border-t border-line pt-6 text-sm leading-relaxed text-muted">
      <p>
        {ui.footerBefore}<a class="text-ink underline decoration-line underline-offset-2" href={YT_PLAYLIST}>{ui.footerPlaylist}</a>{ui.footerAndRepo}<a class="text-ink underline decoration-line underline-offset-2" href={LAB_REPO}>{ui.footerRepo}</a>{ui.footerAfterRepo}
      </p>
      <p class="mt-2">
        {ui.footerVideoBefore}<a class="text-ink underline decoration-line underline-offset-2" href={REDHAT_EXAM_VIDEO}>{ui.videoTitle}</a>.
      </p>
    </footer>
  </div>
  <noscript>
    <p class="mx-auto max-w-5xl px-5 text-sm">{ui.noscript}</p>
  </noscript>
</Base>

<script>
  import { mountHome } from "../scripts/home-status";
  mountHome();
</script>
