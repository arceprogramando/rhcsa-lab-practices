---
import Base from "../layouts/Base.astro";
import { getUI, routePath, type Locale } from "../lib/i18n";
import { YT_PLAYLIST, LAB_REPO, REDHAT_EXAM_VIDEO } from "../lib/labs";
import { PAUSABLE_ENABLED } from "../lib/storage";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUI(locale);
const statsFixed = `${routePath(locale, "stats")}?mode=fixed`;
const statsPausable = `${routePath(locale, "stats")}?mode=pausable`;
---

<Base title={ui.homeTitle} description={ui.homeDescription} locale={locale} route="home">
  <div class="mx-auto flex max-w-5xl flex-col gap-10 px-5 py-10">
    <section class="grid gap-8 lg:grid-cols-[minmax(0,1.35fr)_minmax(16rem,0.85fr)] lg:items-start lg:gap-10">
      <div class="min-w-0">
        <p class="text-sm font-semibold tracking-[0.18em] text-muted uppercase">{ui.kicker}</p>
        <h1 class="mt-3 max-w-xl text-4xl font-semibold tracking-tight sm:text-5xl">{ui.headline}</h1>
        <p class="mt-4 max-w-xl text-base text-muted sm:text-lg">
          {ui.leadBefore}<a class="text-ink underline decoration-line underline-offset-2" href={REDHAT_EXAM_VIDEO}>{ui.videoTitle}</a>{ui.leadAfter}
        </p>
        <p class="mt-3 max-w-xl text-sm text-muted">{ui.hello}</p>

        <div class="mt-8 rounded-3xl border-2 border-ink bg-card p-5 sm:p-6">
          <p class="text-sm font-semibold text-muted uppercase sm:tracking-[0.14em]">{ui.editionLabel}</p>
          <div class="choice mt-2" role="group" aria-label={ui.editionLabel}>
            <button id="edition-v10" class="choice-option is-on" type="button" aria-pressed="true">{ui.editionV10}</button>
            <button id="edition-v9" class="choice-option" type="button" aria-pressed="false">{ui.editionV9}</button>
          </div>
          <p class="mt-2 text-sm text-muted">{ui.editionNote}</p>
          <p id="edition-next" class="mt-2 hidden text-sm text-ink"></p>
          <div id="resume-wrap" class="mt-6 hidden border-t border-line pt-6">
            <button id="resume-exam" class="btn btn-primary w-full sm:w-auto" type="button">{ui.resume}</button>
            <p id="start-note" class="mt-2 text-sm text-muted"></p>
          </div>
          <div id="start-wrap">
            <p id="start-modes-label" class="mt-5 text-sm font-semibold text-muted uppercase sm:tracking-[0.14em]">{ui.startModesLabel}</p>
            <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
              <button id="start-fixed" class="btn btn-primary" type="button">{PAUSABLE_ENABLED ? ui.startFixed : ui.start}</button>
              <button id="start-pausable" class:list={["btn btn-quiet", { hidden: !PAUSABLE_ENABLED }]} type="button">{ui.startPausable}</button>
            </div>
            <div id="start-hints">
              <p class="mt-3 text-sm font-medium text-ink">{ui.startFixedHint}</p>
              <p class:list={["mt-1.5 text-sm text-muted", { hidden: !PAUSABLE_ENABLED }]}>{ui.modesNote}</p>
            </div>
          </div>
        </div>
      </div>

      <aside class="flex flex-col gap-4 lg:sticky lg:top-6">
        <section class="rounded-3xl border-2 border-ink bg-card p-5" aria-labelledby="delta-title">
          <h2 id="delta-title" class="text-sm font-semibold tracking-[0.16em] text-muted uppercase">{ui.improvementFixed}</h2>
          <p id="stat-delta-fixed" class="mt-3 text-xl font-semibold tracking-tight sm:text-2xl">{ui.loading}</p>
        </section>
        <section id="last-run" class="hidden rounded-3xl border border-line bg-card px-5 py-4">
          <p class="text-sm text-muted">{ui.lastClose} · <span data-when></span></p>
          <p data-detail class="stat-value mt-1 text-base font-semibold leading-snug"></p>
        </section>
        <div class="rounded-3xl border border-line bg-card px-5 py-4">
          <p class="text-sm font-semibold tracking-[0.14em] text-muted uppercase">{ui.seeStats}</p>
          <p class="mt-3 flex flex-col gap-2">
            <a
              class="text-sm font-semibold text-ink underline decoration-line underline-offset-2"
              href={statsFixed}
            >{PAUSABLE_ENABLED ? ui.seeStatsFixed : ui.seeStats}</a>
            {PAUSABLE_ENABLED && (
              <a
                class="text-sm font-medium text-muted underline decoration-line underline-offset-2 hover:text-ink"
                href={statsPausable}
              >{ui.seeStatsPausable}</a>
            )}
          </p>
          <p id="times-note" class="mt-3 text-sm text-muted">{ui.timesNote}</p>
        </div>
      </aside>
    </section>

    <section class:list={["grid gap-4", { "lg:grid-cols-2": PAUSABLE_ENABLED }]} aria-label={ui.seeStats}>
      <article class="rounded-3xl border-2 border-ink bg-card px-5 py-5">
        <h2 class="text-sm font-semibold tracking-[0.14em] text-ink uppercase">{ui.statsModeFixed}</h2>
        <dl class:list={["mt-4 grid grid-cols-2 gap-3", { "sm:grid-cols-4": !PAUSABLE_ENABLED }]}>
          <div>
            <dt class="text-sm text-muted">{ui.runs}</dt>
            <dd id="stat-fixed-runs" class="stat-value mt-1 text-2xl font-semibold">—</dd>
          </div>
          <div>
            <dt class="text-sm text-muted">{ui.best}</dt>
            <dd id="stat-fixed-best" class="stat-value mt-1 text-2xl font-semibold">—</dd>
          </div>
          <div>
            <dt class="text-sm text-muted">{ui.withHelp}</dt>
            <dd id="stat-fixed-help" class="stat-value mt-1 text-2xl font-semibold">—</dd>
          </div>
          <div>
            <dt class="text-sm text-muted">{ui.passed}</dt>
            <dd id="stat-fixed-skip" class="stat-value mt-1 text-2xl font-semibold">—</dd>
          </div>
        </dl>
      </article>
      <article class:list={["rounded-3xl border border-line bg-card px-5 py-5", { hidden: !PAUSABLE_ENABLED }]}>
        <h2 class="text-sm font-semibold tracking-[0.14em] text-muted uppercase">{ui.statsModePausable}</h2>
        <p id="stat-delta-pausable" class="mt-3 text-sm text-muted">{ui.loading}</p>
        <dl class="mt-4 grid grid-cols-2 gap-3">
          <div>
            <dt class="text-sm text-muted">{ui.runs}</dt>
            <dd id="stat-pausable-runs" class="stat-value mt-1 text-2xl font-semibold">—</dd>
          </div>
          <div>
            <dt class="text-sm text-muted">{ui.best}</dt>
            <dd id="stat-pausable-best" class="stat-value mt-1 text-2xl font-semibold">—</dd>
          </div>
          <div>
            <dt class="text-sm text-muted">{ui.withHelp}</dt>
            <dd id="stat-pausable-help" class="stat-value mt-1 text-2xl font-semibold">—</dd>
          </div>
          <div>
            <dt class="text-sm text-muted">{ui.passed}</dt>
            <dd id="stat-pausable-skip" class="stat-value mt-1 text-2xl font-semibold">—</dd>
          </div>
        </dl>
      </article>
    </section>

    <footer class="border-t border-line pt-6 text-sm leading-relaxed text-muted">
      <p>
        {ui.footerBefore}<a class="text-ink underline decoration-line underline-offset-2" href={YT_PLAYLIST}>{ui.footerPlaylist}</a>{ui.footerAndRepo}<a class="text-ink underline decoration-line underline-offset-2" href={LAB_REPO}>{ui.footerRepo}</a>{ui.footerAfterRepo}
      </p>
    </footer>
  </div>
  <noscript>
    <p class="mx-auto max-w-5xl px-5 text-sm">{ui.noscript}</p>
  </noscript>
</Base>

<script>
  import { mountHome } from "../scripts/home-status";
  mountHome();
</script>
